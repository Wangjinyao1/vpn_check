# ============================================================
# vpn_check 环境变量模板（.env.example）
# 复制为 .env 后填入真实配置；.env 已加入 .gitignore，禁止提交
# ============================================================

# ---------- 机场订阅（1~10 组，至少 1 组） ----------
SUBSCRIBE_name_1=机场名称1
SUBSCRIBE_URL_1=https://example.com/api/v1/client/subscribe?token=your_token_here_1

SUBSCRIBE_name_2=机场名称2
SUBSCRIBE_URL_2=https://example.org/sub?token=your_token_here_2

# SUBSCRIBE_name_3=机场名称3
# SUBSCRIBE_URL_3=https://example.net:8443/api/v1/client/your_token_here_3

# ---------- 订阅拉取参数（可选） ----------
# 订阅直连失败时依次尝试的本地代理（逗号分隔，留空则只走直连）
SUBSCRIPTION_PROXY=http://127.0.0.1:7890,socks5h://127.0.0.1:10808
SUBSCRIBE_TIMEOUT=15
SUBSCRIBE_RETRY=1
SUBSCRIBE_WORKERS=5

# ---------- Gemini 登录提问凭据（可选） ----------
# 浏览器登录 gemini.google.com 后，在 DevTools -> Application -> Cookies 获取
# 留空则只做免登录访问与地区封锁检测
GEMINI_1PSID=
GEMINI_1PSIDTS=
# GEMINI_CHAT_QUESTION=请回答：1+1等于几？只回答一个阿拉伯数字。
# GEMINI_CHAT_EXPECT=2
# GEMINI_CHAT_TIMEOUT=25

# ---------- IP 归属地（可选） ----------
# 留空则直接使用 ipinfo.io 免 token 查询（有频率限制）
# IPINFO_TOKEN=
# IPINFO_URL=https://ipinfo.io/{ip}/json

# ---------- 并发与超时（可选） ----------
DEFAULT_WORKERS=10
MAX_WORKERS=32
PROBE_TIMEOUT=6
SITE_TIMEOUT=12
KERNEL_START_TIMEOUT=8

# ---------- 节点测速（可选，指标对齐 Speedtest CLI） ----------
# 引擎：builtin（内置采样，默认）/ ookla（官方 CLI）/ auto（有 CLI 就用）
SPEEDTEST_PROVIDER=builtin
# 官方 CLI 路径，留空则自动查找 bin/speedtest 与 PATH
# SPEEDTEST_BIN=bin/speedtest
# 官方 CLI 单节点整轮超时（秒，含选服 + 下载 + 上传）
SPEEDTEST_OOKLA_TIMEOUT=60
# 测速并发度：1 = 数字最可比（定榜用），2 = 速度与可信度折中
SPEEDTEST_WORKERS=2
# 仅测延迟最低的前 N 个节点（0 = 全部代理通节点都测）
SPEEDTEST_TOP=0
# 低于该速率视为采样异常，自动重测一次并取较好值
# SPEEDTEST_RETRY_FLOOR=0.1
# 内置实现的采样大小与超时（官方 CLI 不可用时使用）
SPEEDTEST_DOWNLOAD_BYTES=10485760
SPEEDTEST_DOWNLOAD_TIMEOUT=10
# 内置上传测速默认关闭；官方 CLI 始终包含上传
SPEEDTEST_UPLOAD_ENABLED=0
# 内置 ping 采样次数（用于抖动计算）
SPEEDTEST_PINGS=3
# 下载地址模板，含 {bytes} 占位符；逗号分隔按顺序回退
# SPEEDTEST_URL=https://speed.cloudflare.com/__down?bytes={bytes},https://proof.ovh.net/files/10Mb.dat

# ---------- 内核路径（可选，默认自动查找 bin/ 下的 xray / sing-box） ----------
# XRAY_BIN=bin/xray
# SINGBOX_BIN=bin/sing-box
# ENABLE_CORE_FALLBACK=1
# Hysteria2 机场下发的 pcs 为「证书哈希」，sing-box 只支持「公钥哈希」，
# 无法换算时退化为跳过证书校验（仅用于连通性评估）。置 0 可关闭该退化。
HYSTERIA2_PIN_INSECURE=1
