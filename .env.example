# ============================================================
# vpn_check 环境变量模板（.env.example）
# 复制为 .env 后填入真实配置；.env 已加入 .gitignore，禁止提交
# ============================================================

# ---------- 机场订阅（1~10 组，至少 1 组） ----------
SUBSCRIBE_name_1=机场名称1
SUBSCRIBE_URL_1=https://example.com/api/v1/client/subscribe?token=your_token_here_1

SUBSCRIBE_name_2=机场名称2
SUBSCRIBE_URL_2=https://example.org/sub?token=your_token_here_2

# SUBSCRIBE_name_3=机场名称3
# SUBSCRIBE_URL_3=https://example.net:8443/api/v1/client/your_token_here_3

# ---------- 订阅拉取参数（可选） ----------
# 订阅直连失败时依次尝试的本地代理（逗号分隔，留空则只走直连）
SUBSCRIPTION_PROXY=http://127.0.0.1:7890,socks5h://127.0.0.1:10808
SUBSCRIBE_TIMEOUT=15
SUBSCRIBE_RETRY=1
SUBSCRIBE_WORKERS=5

# ---------- Gemini 登录提问凭据（可选） ----------
# 浏览器登录 gemini.google.com 后，在 DevTools -> Application -> Cookies 获取
# 留空则只做免登录访问与地区封锁检测
GEMINI_1PSID=
GEMINI_1PSIDTS=
# GEMINI_CHAT_QUESTION=请回答：1+1等于几？只回答一个阿拉伯数字。
# GEMINI_CHAT_EXPECT=2

# ---------- 数据库（MySQL / MariaDB，必填项留空则跳过持久化） ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_DATABASE=your_database_name
DB_CHARSET=utf8mb4
DB_ENABLED=1

# ---------- IP 归属地（可选） ----------
# 规范指定的 IP 查询助手脚本路径；留空则使用内置 ipinfo 查询
IP_LOCATION_HELPER=
# IPINFO_TOKEN=
# IPINFO_URL=https://ipinfo.io/{ip}/json

# ---------- 并发与超时（可选） ----------
DEFAULT_WORKERS=10
MAX_WORKERS=32
PROBE_TIMEOUT=6
SITE_TIMEOUT=12
KERNEL_START_TIMEOUT=8

# ---------- 内核路径（可选，默认自动查找 bin/ 下的 xray / sing-box） ----------
# XRAY_BIN=bin/xray
# SINGBOX_BIN=bin/sing-box
# ENABLE_CORE_FALLBACK=1
